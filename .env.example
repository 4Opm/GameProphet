# Copy this file to .env and fill in your own values.

# PostgreSQL connection string.
# Matches the database started by `docker compose up -d` (see docker-compose.yml).
DATABASE_URL=postgresql://gameprophet:gameprophet@localhost:5432/gameprophet

# football-data.org API key (free plan): https://www.football-data.org/client/register
API_KEY=

# The Odds API key (free plan): https://the-odds-api.com/
# Without it no odds are fetched, and agents only bet on matches that have odds.
ODDS_API_KEY=

# AI provider: "groq" (cloud, free API key) or "ollama" (local model, no key needed)
AI_PROVIDER=groq

# Groq API key: https://console.groq.com/keys (not needed with AI_PROVIDER=ollama)
GROQ_API_KEY=

# --- Optional -------------------------------------------------------------

# Public URL of the site, used in sitemap.xml, robots.txt and social meta tags.
# SITE_URL=http://localhost:5000

# Google Analytics 4 measurement ID. Leave empty to disable tracking.
# GA_MEASUREMENT_ID=

# Set to 1 to run only the website, without fetching data or placing bets.
# DISABLE_SCHEDULER=0

# Port for `python app.py`
# PORT=5000
